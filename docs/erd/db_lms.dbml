Project Edu_LMS {
  database_type: 'PostgreSQL'
  Note: 'LMS Module - Assignments, Materials, Submissions'
}

Table materials {
  id          uuid         [pk]
  class_id    uuid         [not null, note: 'Soft Link -> Academic.classes.id']
  title       varchar(255) [not null]
  description text
  file_url    varchar(500)
  uploaded_by uuid         [not null, note: 'Soft Link -> User.teachers.id']
  created_at  timestamp    [default: `now()`]
}

Table assignments {
  id          uuid         [pk]
  class_id    uuid         [not null, note: 'Soft Link -> Academic.classes.id']
  title       varchar(255) [not null]
  description text
  due_date    timestamp
  created_by  uuid         [not null, note: 'Soft Link -> User.teachers.id']
  created_at  timestamp    [default: `now()`]
}

Table submissions {
  id            uuid         [pk]
  assignment_id uuid         [ref: > assignments.id, not null]
  student_id    uuid         [not null, note: 'Soft Link -> User.students.id']
  content       text
  file_url      varchar(500)
  submitted_at  timestamp    [default: `now()`]
  
  indexes {
    (assignment_id, student_id) [unique]
  }
}
