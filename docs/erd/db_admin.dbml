Project Edu_Admin {
  database_type: 'PostgreSQL'
  Note: 'Admin Module - System configurations, reports, and dashboards'
}

Table system_configs {
  id          varchar(100) [pk, note: 'VD: MAX_STUDENTS_PER_CLASS']
  value       varchar(255) [not null]
  description text
  updated_at  timestamp    [default: `now()`]
  updated_by  uuid         [note: 'Soft Link -> Auth.auth_users.id']
}

Table reports {
  id          uuid         [pk]
  name        varchar(255) [not null]
  type        varchar(50)  [note: 'FINANCIAL, ACADEMIC, SYSTEM']
  data        jsonb        [note: 'Snapshot dữ liệu report']
  generated_at timestamp   [default: `now()`]
  generated_by uuid        [note: 'Soft Link -> Auth.auth_users.id']
}
