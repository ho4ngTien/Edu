Project Edu_User {
  database_type: 'PostgreSQL'
  Note: 'User Module - Profile and personal information (Student, Teacher, Staff)'
}

Table profiles {
  id            uuid         [pk]
  user_id       uuid         [unique, not null, note: 'Soft Link -> Auth.auth_users.id']
  full_name     varchar(255) [not null]
  dob           date
  gender        varchar(20)
  phone         varchar(20)
  address       text
  avatar_url    varchar(500)
  created_at    timestamp    [default: `now()`]
  updated_at    timestamp
}

Table students {
  id            uuid         [pk]
  profile_id    uuid         [ref: - profiles.id, unique, not null]
  student_code  varchar(50)  [unique, not null]
  admission_date date
}

Table teachers {
  id            uuid         [pk]
  profile_id    uuid         [ref: - profiles.id, unique, not null]
  teacher_code  varchar(50)  [unique, not null]
  department    varchar(100)
  hire_date     date
}

Table staffs {
  id            uuid         [pk]
  profile_id    uuid         [ref: - profiles.id, unique, not null]
  staff_code    varchar(50)  [unique, not null]
  department    varchar(100)
}
