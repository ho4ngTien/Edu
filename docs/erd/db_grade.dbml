Project Edu_Grade {
  database_type: 'PostgreSQL'
  Note: 'Grade Module - Grades, GPA, Transcripts'
}

Table grades {
  id            uuid         [pk]
  submission_id uuid         [not null, note: 'Soft Link -> LMS.submissions.id (Optional if graded without submission)']
  assignment_id uuid         [not null, note: 'Soft Link -> LMS.assignments.id']
  student_id    uuid         [not null, note: 'Soft Link -> User.students.id']
  score         decimal      [not null]
  feedback      text
  graded_by     uuid         [not null, note: 'Soft Link -> User.teachers.id']
  graded_at     timestamp    [default: `now()`]
}

Table transcripts {
  id            uuid         [pk]
  student_id    uuid         [not null, note: 'Soft Link -> User.students.id']
  semester      varchar(50)  [not null]
  gpa           decimal      
  total_credits int
  issued_at     timestamp    [default: `now()`]
  
  indexes {
    (student_id, semester) [unique]
  }
}
