Project Edu_Notification {
  database_type: 'PostgreSQL'
  Note: 'Notification Module - Emails, Reminders, In-App Notifications'
}

Table notifications {
  id          uuid         [pk]
  user_id     uuid         [not null, note: 'Soft Link -> Auth.auth_users.id']
  title       varchar(255) [not null]
  content     text         [not null]
  is_read     boolean      [default: false]
  type        varchar(50)  [note: 'SYSTEM, DEADLINE, GRADE']
  created_at  timestamp    [default: `now()`]
}

Table email_logs {
  id          uuid         [pk]
  recipient   varchar(255) [not null]
  subject     varchar(255) [not null]
  body        text
  status      varchar(50)  [note: 'PENDING, SENT, FAILED']
  sent_at     timestamp
  created_at  timestamp    [default: `now()`]
}
