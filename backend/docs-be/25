package com.edu.organization.infrastructure.persistence.entity;

import com.edu.organization.domain.model.OrganizationStatus;
import com.edu.shared.kernel.persistence.AuditableEntity;
import jakarta.persistence.*;

import java.util.UUID;

@Entity
@Table(
    name = "organizations",
    schema = "organization",
    uniqueConstraints = @UniqueConstraint(
        name = "uk_organizations_code",
        columnNames = "code"
    )
)
public class OrganizationEntity extends AuditableEntity {

    @Id
    private UUID id;

    @Column(nullable = false, length = 50)
    private String code;

    @Column(nullable = false, length = 255)
    private String name;

    @Enumerated(EnumType.STRING)
    @Column(nullable = false, length = 30)
    private OrganizationStatus status;

    protected OrganizationEntity() {
    }

    public OrganizationEntity(
        UUID id,
        String code,
        String name,
        OrganizationStatus status
    ) {
        this.id = id;
        this.code = code;
        this.name = name;
        this.status = status;
    }

    public UUID getId() {
        return id;
    }

    public String getCode() {
        return code;
    }

    public String getName() {
        return name;
    }

    public OrganizationStatus getStatus() {
        return status;
    }

    public void rename(String name) {
        this.name = name;
    }

    public void changeStatus(OrganizationStatus status) {
        this.status = status;
    }
}

Trong các bước tiếp theo, có thể bổ sung domain validation cho code và name để từ chối giá trị rỗng trước khi ghi xuống database. Database constraints vẫn cần được giữ để bảo vệ tính toàn vẹn dữ liệu.

4. Organization module — Membership Entity
Membership là phần kết nối tài khoản với tổ chức. Một tài khoản có thể có nhiều membership, nhưng không được có hai membership cho cùng một tổ chức.

Enum:

package com.edu.organization.domain.model;

public enum MembershipStatus {
    INVITED,
    ACTIVE,
    SUSPENDED,
    LEFT
}

package com.edu.organization.domain.model;

public enum OrganizationRole {
    OWNER,
    ADMIN,
    MEMBER
}

Entity:

package com.edu.organization.infrastructure.persistence.entity;

import com.edu.organization.domain.model.MembershipStatus;
import com.edu.organization.domain.model.OrganizationRole;
import com.edu.shared.kernel.persistence.AuditableEntity;
import jakarta.persistence.*;

import java.time.Instant;
import java.util.UUID;

@Entity
@Table(
    name = "organization_memberships",
    schema = "organization",
    uniqueConstraints = @UniqueConstraint(
        name = "uk_memberships_organization_user",
        columnNames = {"organization_id", "user_id"}
    ),
    indexes = {
        @Index(
            name = "idx_memberships_user_status",
            columnList = "user_id, status"
        ),
        @Index(
            name = "idx_memberships_organization_status",
            columnList = "organization_id, status"
        )
    }
)
public class OrganizationMembershipEntity
    extends AuditableEntity {

    @Id
    private UUID id;

    @Column(name = "organization_id", nullable = false)
    private UUID organizationId;

    @Column(name = "user_id", nullable = false)
    private UUID userId;

    @Enumerated(EnumType.STRING)
    @Column(nullable = false, length = 30)
    private MembershipStatus status;

    @Enumerated(EnumType.STRING)
    @Column(nullable = false, length = 30)
    private OrganizationRole role;

    @Column(name = "joined_at")
    private Instant joinedAt;

    protected OrganizationMembershipEntity() {
    }

    public OrganizationMembershipEntity(
        UUID id,
        UUID organizationId,
        UUID userId,
        MembershipStatus status,
        OrganizationRole role
    ) {
        this.id = id;
        this.organizationId = organizationId;
        this.userId = userId;
        this.status = status;
        this.role = role;
    }

    public UUID getId() {
        return id;
    }

    public UUID getOrganizationId() {
        return organizationId;
    }

    public UUID getUserId() {
        return userId;
    }

    public MembershipStatus getStatus() {
        return status;
    }

    public OrganizationRole getRole() {
        return role;
    }

    public Instant getJoinedAt() {
        return joinedAt;
    }

    public void activate(Instant now) {
        this.status = MembershipStatus.ACTIVE;

        if (this.joinedAt == null) {
            this.joinedAt = now;
        }
    }

    public void suspend() {
        this.status = MembershipStatus.SUSPENDED;
    }

    public void leave() {
        this.status = MembershipStatus.LEFT;
    }

    public void changeRole(OrganizationRole role) {
        this.role = role;
    }
}

Vì sao không dùng @ManyToOne?
Không sử dụng:

// Bad: tạo quan hệ JPA xuyên module
@ManyToOne
private UserEntity user;

Thay vào đó:

// Good: chỉ giữ logical reference
@Column(name = "user_id", nullable = false)
private UUID userId;

Cách này giúp organization không phụ thuộc trực tiếp vào JPA Entity của identity, tránh phá vỡ ranh giới module.

Lưu ý về quyền OWNER: entity trên chưa tự bảo đảm mỗi tổ chức có ít nhất một owner, hoặc chỉ có một owner. Đây là business invariant cần xử lý ở application/domain service và được kiểm thử riêng. Nếu cần bảo đảm một owner duy nhất ngay tại database, có thể bổ sung partial unique index ở migration sau khi thống nhất chính sách chuyển giao quyền sở hữu.

