package com.edu.identity.application.service;

import com.edu.identity.application.command.RegisterAccountCommand;
import com.edu.identity.application.dto.AccountView;
import com.edu.identity.domain.model.UserStatus;
import com.edu.identity.infrastructure.persistence.entity.UserEntity;
import com.edu.identity.infrastructure.persistence.repository.UserJpaRepository;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Locale;
import java.util.UUID;

@Service
public class IdentityService {

    private final UserJpaRepository userRepository;
    private final PasswordEncoder passwordEncoder;

    public IdentityService(
        UserJpaRepository userRepository,
        PasswordEncoder passwordEncoder
    ) {
        this.userRepository = userRepository;
        this.passwordEncoder = passwordEncoder;
    }

    @Transactional
    public AccountView register(RegisterAccountCommand command) {
        String username = normalizeUsername(command.username());
        String email = normalizeEmail(command.email());
        String rawPassword = validatePassword(command.rawPassword());

        if (userRepository.existsByUsername(username)) {
            throw new DuplicateAccountException("Username is already taken");
        }

        if (userRepository.existsByEmail(email)) {
            throw new DuplicateAccountException("Email is already registered");
        }

        String passwordHash = passwordEncoder.encode(rawPassword);

        UserEntity user = new UserEntity(
            UUID.randomUUID(),
            username,
            email,
            passwordHash,
            UserStatus.ACTIVE
        );

        UserEntity saved = userRepository.save(user);

        return toAccountView(saved);
    }

    private String normalizeUsername(String username) {
        if (username == null || username.isBlank()) {
            throw new InvalidAccountInputException(
                "Username must not be blank"
            );
        }

        String normalized = username.trim();

        if (!normalized.matches("[A-Za-z0-9._-]{3,100}")) {
            throw new InvalidAccountInputException(
                "Username has an invalid format"
            );
        }

        return normalized.toLowerCase(Locale.ROOT);
    }

    private String normalizeEmail(String email) {
        if (email == null || email.isBlank()) {
            throw new InvalidAccountInputException(
                "Email must not be blank"
            );
        }

        String normalized = email.trim().toLowerCase(Locale.ROOT);

        if (normalized.length() > 255
            || !normalized.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) {
            throw new InvalidAccountInputException(
                "Email has an invalid format"
            );
        }

        return normalized;
    }

    private String validatePassword(String password) {
        if (password == null || password.length() < 12) {
            throw new InvalidAccountInputException(
                "Password does not meet the minimum length requirement"
            );
        }

        if (password.length() > 72) {
            throw new InvalidAccountInputException(
                "Password exceeds the supported length"
            );
        }

        return password;
    }

    private AccountView toAccountView(UserEntity user) {
        return new AccountView(
            user.getId(),
            user.getUsername(),
            user.getEmail(),
            user.getStatus()
        );
    }
}

Hai exception DuplicateAccountException và InvalidAccountInputException trong ví dụ là các exception cần định nghĩa trong module identity hoặc ánh xạ sang hệ thống BusinessException/ErrorCode hiện có. Không tạo exception trùng lặp nếu shared-kernel đã cung cấp loại tương đương.

Lưu ý về chuẩn hóa username: ví dụ trên chuyển username về chữ thường, vì vậy Tien và tien được coi là cùng một username. Đây là một quyết định nghiệp vụ cần thống nhất với quy tắc định danh đã chọn. Việc kiểm tra email ở đây là kiểm tra định dạng cơ bản, không xác minh người dùng sở hữu email đó.

Xử lý đăng ký đồng thời
existsByUsername() và existsByEmail() giúp trả lỗi dễ hiểu, nhưng hai request đồng thời vẫn có thể cùng vượt qua bước kiểm tra.

Do đó:

Giữ unique constraints trên username và email.

Xử lý lỗi vi phạm unique constraint ở persistence/application boundary.

Chuyển thành lỗi nghiệp vụ phù hợp, không trả stack trace hoặc SQL cho client.

Không bắt mọi DataIntegrityViolationException rồi coi đó là lỗi username; phải xác định constraint gây lỗi.

6. Public interface cho module khác
Module organization cần kiểm tra trạng thái tài khoản trước khi mời user vào tổ chức. Thay vì truy cập UserJpaRepository, ta cung cấp một public application interface trong identity.

package com.edu.identity.application.port;

import java.util.UUID;

public interface AccountQuery {

    boolean accountExists(UUID userId);

    boolean accountCanJoinOrganization(UUID userId);
}

Implementation bên trong module identity:

package com.edu.identity.application.service;

import com.edu.identity.application.port.AccountQuery;
import com.edu.identity.domain.model.UserStatus;
import com.edu.identity.infrastructure.persistence.repository.UserJpaRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.UUID;

@Service
public class AccountQueryService implements AccountQuery {

    private final UserJpaRepository userRepository;

    public AccountQueryService(UserJpaRepository userRepository) {
        this.userRepository = userRepository;
    }

    @Override
    @Transactional(readOnly = true)
    public boolean accountExists(UUID userId) {
        return userRepository.existsById(userId);
    }

    @Override
    @Transactional(readOnly = true)
    public boolean accountCanJoinOrganization(UUID userId) {
        return userRepository.findById(userId)
            .map(user -> user.getStatus() == UserStatus.ACTIVE)
            .orElse(false);
    }
}

Điểm cần tích hợp: Phase 2.5.4 đã đề xuất OrganizationAccountQuery ở module organization, trong khi identity cung cấp AccountQuery. Không để hai module import implementation của nhau. Có thể dùng một adapter trong boot để nối hai interface, hoặc điều chỉnh contract để các module thống nhất một public interface. Không tạo dependency vòng.

