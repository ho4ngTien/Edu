package com.edu.organization.application.service;

import com.edu.organization.application.command.InviteMemberCommand;
import com.edu.organization.application.port.OrganizationAccountQuery;
import com.edu.organization.domain.model.MembershipStatus;
import com.edu.organization.infrastructure.persistence.entity.OrganizationMembershipEntity;
import com.edu.organization.infrastructure.persistence.repository.OrganizationJpaRepository;
import com.edu.organization.infrastructure.persistence.repository.OrganizationMembershipJpaRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.UUID;

@Service
public class MembershipService {

    private final OrganizationJpaRepository organizationRepository;
    private final OrganizationMembershipJpaRepository membershipRepository;
    private final OrganizationAccountQuery accountQuery;

    public MembershipService(
        OrganizationJpaRepository organizationRepository,
        OrganizationMembershipJpaRepository membershipRepository,
        OrganizationAccountQuery accountQuery
    ) {
        this.organizationRepository = organizationRepository;
        this.membershipRepository = membershipRepository;
        this.accountQuery = accountQuery;
    }

    @Transactional
    public OrganizationMembershipEntity invite(
        InviteMemberCommand command
    ) {
        var organization = organizationRepository
            .findById(command.organizationId())
            .orElseThrow(() -> new IllegalArgumentException(
                "Organization not found"
            ));

        if (!accountQuery.accountExists(command.userId())) {
            throw new IllegalArgumentException("User not found");
        }

        if (!accountQuery.accountCanJoinOrganization(command.userId())) {
            throw new IllegalArgumentException(
                "User cannot join an organization"
            );
        }

        if (membershipRepository.existsByOrganizationIdAndUserId(
            command.organizationId(),
            command.userId()
        )) {
            throw new IllegalArgumentException(
                "Membership already exists"
            );
        }

        if (organization.getStatus()
            != com.edu.organization.domain.model.OrganizationStatus.ACTIVE) {
            throw new IllegalArgumentException(
                "Organization is not active"
            );
        }

        var membership = new OrganizationMembershipEntity(
            UUID.randomUUID(),
            command.organizationId(),
            command.userId(),
            MembershipStatus.INVITED,
            command.role()
        );

        return membershipRepository.save(membership);
    }
}

Đây là skeleton để minh họa use case, chưa phải code hoàn thiện để merge. Trước khi triển khai thực tế cần:

Thay IllegalArgumentException bằng business exceptions có mã lỗi cụ thể.

Kiểm tra quyền của người thực hiện lời mời; không cho phép bất kỳ user nào tự cấp OWNER hoặc ADMIN.

Bổ sung xử lý race condition khi hai request đồng thời tạo membership.

Trả application DTO thay vì JPA Entity.

Xác định chính sách tái mời khi membership cũ có trạng thái LEFT hoặc SUSPENDED.

Quy tắc quan trọng: existsByOrganizationIdAndUserId() không đủ để bảo đảm tính duy nhất khi có request đồng thời. Unique constraint uk_memberships_organization_user trong database mới là cơ chế bảo vệ cuối cùng.

