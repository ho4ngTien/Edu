<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.edu</groupId>
        <artifactId>parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>boot</artifactId>
    <packaging>jar</packaging>

    <name>Application Boot</name>

    <dependencies>
        <!-- Web & Web MVC Layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator for Health & Metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Database & Migration (Phase 2.3 & 2.4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Internal Modular Monolith Modules -->
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>organization</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>configuration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>people</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>curriculum</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>academic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>enrollment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>teaching</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>attendance</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>assessment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>certification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edu</groupId>
            <artifactId>rule-engine</artifactId>
        </dependency>

        <!-- Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
